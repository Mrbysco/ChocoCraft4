{
  "schemaVersion": 1,
  "id": "chococraft",
  "version": "${version}",
  "name": "Chococraft 4",
  "description": "Chocobos in Minecraft\n Thanks to EddieV for the original Chococraft, ArnoSaxena(Torojimas) and clienthax for maintaining it",
  "authors": [
    "Mrbysco",
    "Xalcon",
    "Slayer5934",
    "balika011"
  ],
  "contributors": [
    "Kraehe"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/chococraft",
    "sources": "https://github.com/Mrbysco/ChocoCraft4",
    "issues": "https://github.com/Mrbysco/ChocoCraft4/issues"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "net.chococraft.fabric.datagen.ModDatagenerator"
    ],
    "main": [
      "net.chococraft.fabric.ChococraftFabric"
    ],
    "client": [
      "net.chococraft.fabric.ChococraftClientFabric"
    ],
    "modmenu": [
      "net.chococraft.fabric.common.config.ChococraftMenuIntegration"
    ]
  },
  "mixins": [
    "chococraft.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~1.21.8",
    "java": ">=21",
    "fabric-api": "*",
    "cloth-config": ">=19",
    "architectury": ">=17.0.8"
  },
  "accessWidener": "chococraft.accesswidener"
